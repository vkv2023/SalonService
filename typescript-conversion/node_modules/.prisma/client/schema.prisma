generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SALON_OWNER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCEL
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
}

enum PaymentOrderStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        Int       @id @default(autoincrement())
  clerkId   String?   @unique
  fullName  String?
  username  String    @unique
  fname     String
  lname     String?
  email     String    @unique
  phone     String?
  role      UserRole
  password  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  salons    Salon[]
  bookings  Booking[] @relation("BookingCustomer")
}

model Salon {
  id         Int               @id @default(autoincrement())
  name       String
  images     Json?
  address    String
  phone      String
  email      String
  city       String
  ownerId    Int
  openTime   String
  closeTime  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  owner      User              @relation(fields: [ownerId], references: [id])
  categories Category[]
  services   ServiceOffering[]
  bookings   Booking[]
}

model Category {
  id        Int               @id @default(autoincrement())
  name      String
  image     String?
  salonId   Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  salon     Salon             @relation(fields: [salonId], references: [id])
  services  ServiceOffering[]
}

model ServiceOffering {
  id          Int              @id @default(autoincrement())
  name        String
  description String
  price       Int
  duration    Int
  salonId     Int
  categoryId  Int
  image       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  salon       Salon            @relation(fields: [salonId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  bookingRefs BookingService[]
}

model Booking {
  id            Int              @id @default(autoincrement())
  salonId       Int
  customerId    Int
  bookingStatus BookingStatus    @default(PENDING)
  startTime     DateTime
  endTime       DateTime
  totalPrice    Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  salon         Salon            @relation(fields: [salonId], references: [id])
  customer      User             @relation("BookingCustomer", fields: [customerId], references: [id])
  services      BookingService[]
  paymentOrders PaymentOrder[]
}

model BookingService {
  bookingId Int
  serviceId Int
  booking   Booking         @relation(fields: [bookingId], references: [id])
  service   ServiceOffering @relation(fields: [serviceId], references: [id])

  @@id([bookingId, serviceId])
}

model PaymentOrder {
  id            Int                @id @default(autoincrement())
  amount        Int
  status        PaymentOrderStatus @default(PENDING)
  paymentMethod PaymentMethod
  paymentLinkId String?
  userId        Int
  bookingId     Int
  salonId       Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  booking       Booking            @relation(fields: [bookingId], references: [id])
}
