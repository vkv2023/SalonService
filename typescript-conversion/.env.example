# Neon PostgreSQL connection string
DATABASE_URL="postgresql://neondb_owner:npg_L9fWZi4leuhJ@ep-sparkling-poetry-azzq6mlg-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Service selector: user | salon | category | service-offering | booking | payment
SERVICE_NAME="user"
PORT="5001"

# Auth mode: clerk | legacy | hybrid
# clerk: strictly verify Clerk JWT in services
# legacy: trust x-user-id and x-user-role headers only
# hybrid: accept legacy headers first, then Clerk JWT
AUTH_MODE="clerk"

# Clerk replacement-path values (used by gateway / edge auth in rollout)
CLERK_ISSUER="https://your-tenant.clerk.accounts.dev"
CLERK_JWKS_URL="https://your-tenant.clerk.accounts.dev/.well-known/jwks.json"
CLERK_AUDIENCE="salon-api"
